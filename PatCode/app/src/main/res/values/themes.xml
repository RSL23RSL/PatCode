<resources>
    <style name="Theme.PatCode" parent="Theme.Material3.DayNight">
        <item name="colorPrimary">@color/azul</item>
        <item name="colorPrimaryDark">@color/azul_escuro</item>
        <item name="colorSecondary">@color/verde</item>
        <item name="actionBarStyle">@style/PatCode.ActionBar</item>
    </style>
    <style name="PatCode.ActionBar" parent="Widget.Material3.ActionBar.Solid">
        <item name="background">@color/azul</item>
        <item name="titleTextStyle">@style/PatCode.ActionBarTitle</item>
    </style>
    <style name="PatCode.ActionBarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">#FFFFFF</item>
    </style>
</resources>
